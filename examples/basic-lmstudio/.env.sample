# Google Gemini API (preferred — auto-detected when set)
# GEMINI_API_KEY=your-api-key-here

# Delay between LLM calls (Gemini free tier: 5 req/min → use 13s, 0 = no delay)
# REQUEST_DELAY=13s

# LM Studio fallback (used when GEMINI_API_KEY is not set)
LMSTUDIO_URL=http://localhost:1234/v1
# Recommended: qwen2.5-72b-instruct (Q4_K_M, ~42GB) for best extraction quality
# Lighter alternative: qwen2.5-32b-instruct (Q5_K_M, ~24GB)
LMSTUDIO_MODEL=qwen2.5-72b-instruct
